image:
  repository: "adsignal/match"
  tag: "loadtest-1.0.1-prerelease-5-486ac3d"

rails_env: production
precompiling_assets: "false"

useArgoSyncWaveAnnotations: true

storage:
  sharedStorage:
    claimName: match-shared-storage
    enabled: true
    size: 100Gi
    storageClassName: match-shared-storage
  tmpStorage:
    enabled: true
    sizeLimit: 200Gi

podSecurityContext:
  fsGroup: 65532 # nonroot group

securityContext:
  runAsUser: 65532 # nonroot user
  runAsGroup: 65532
  readOnlyRootFilesystem: true

honeybadger:
  secretName: honeybadger-api
  secretKey: key
  environment: "${eks_cluster_name}" # REQUIRED: Your Honeybadger environment name 

imagePullSecrets:
  - name: "dockerconfig"

volumes:
  - name: docker-secret
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-docker-secret-provider-class"
  - name: rds-secret
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-rds-secret-provider-class"
  - name: honeybadger-api
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-honeybadger-secret-provider-class"
  - name: smtp-secret
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-smtp-secret-provider-class"
  - name: match-api-secrets
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-api-secret-provider-class"
  - name: match-owning-user-credentials
    csi:
      driver: secrets-store.csi.k8s.io
      readOnly: true
      volumeAttributes:
        secretProviderClass: "match-owning-user-credentials-secret-provider-class"
  - name: tmp-volume
    emptyDir: {}
  - name: log-volume
    emptyDir: {}
    
volumeMounts:
  - name: docker-secret
    mountPath: "/mnt/secrets-store"
    readOnly: true
  - name: rds-secret
    mountPath: "/mnt/rds-secrets-store"
    readOnly: true
  - name: honeybadger-api
    mountPath: "/mnt/honeybadger-api"
    readOnly: true
  - name: smtp-secret
    mountPath: "/mnt/smtp-secret"
    readOnly: true
  - mountPath: /app/tmp
    name: tmp-volume
  - mountPath: /app/log
    name: log-volume
  - name: match-api-secrets
    mountPath: "/mnt/match-api-secrets"
    readOnly: true
  - name: match-owning-user-credentials
    mountPath: "/mnt/match-owning-user-credentials"
    readOnly: true
postgres:
  enabled: false # disabled because using external RDS
  passwordSecret:
    name: "${eks_cluster_name}-rds-pg"
    key: "password"
  userNameSecret:
    name: "${eks_cluster_name}-rds-pg"
    key: "username"
  dbNameSecret:
    name: "${eks_cluster_name}-rds-pg"
    key: "db_name"
  dbPrimaryHostSecret:
    name: "${eks_cluster_name}-rds-pg"
    key: "host"

migrateJob:
  enabled: true

domain: ${domain}

# Ad Signal Workloads:
webServers:
  port: 3000
  replicas: 1
  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: 1000m
      memory: 2Gi

ingress:
  enabled: true
  className: "match-alb"
  annotations:
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/certificate-arn: ${certificate_arn}
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"
    alb.ingress.kubernetes.io/backend-protocol: HTTP
    alb.ingress.kubernetes.io/healthcheck-path: /users/sign_in
    alb.ingress.kubernetes.io/success-codes: "200-402"
    external-dns.alpha.kubernetes.io/hostname: ${domain}

  hosts:
    - host: ${domain}
      paths:
        - path: /
          pathType: Prefix

serviceAccount:
  create: true
  automount: true
  argoSyncWaveAnnotations:
    argocd.argoproj.io/sync-wave: '-2'
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::${account_id}:role/${eks_cluster_name}-service-account-role

s3:
  primaryBucket: ${eks_cluster_name}-primary
  region: ${region}

railsConsole:
  enabled: true

workerDeploymentStrategy: "Recreate"

extraEnvs:
  - name: LOAD_TESTING_ORGANISATION_NAME
    value: AutoIngest
  - name: LOAD_TESTING_BUCKET
    value: "hub-v1-sandbox-testing-assets-use-1"
  - name: HONEYBADGER_ENVIRONMENT
    value: ${eks_cluster_name}
extraEnvSecrets:
  - name: HONEYBADGER_API_KEY
    secretName: honeybadger-api
    secretKey: key

monitoring:
  enabled: false # By Argo Apps
  logging:
    enabled: false # By Argo Apps
  awsDashboards:
    enabled: true
    cloudwatch:
      assumeRoleArn: arn:aws:iam::${account_id}:role/${eks_cluster_name}-grafana-cloudwatch
      defaultRegion: ${region}
  postgresDashboards:
    enabled: true

owningUser:
  email: "${owning_user_email}"
  firstName: "Admin"
  lastName: "User"
  organisationName: "${organisation_name}"
  secretName: "${user_secret_name}"

secretKeys:
  secret:
    name: "match-api-secrets" ## if https://github.com/ad-signalio/argocd-match-managed/blob/staging/cluster-resources-manifests/secrets-configuration/templates/apisecretproviderclass.yaml changes then this also needs to change

materialProcessingPipelines: "default|duration>=0"
materialProcessingCount: "default=5"